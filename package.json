{
  "name": "codex-manage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local:public": "npm run build:client && concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:serve:client\"",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "CODEX_WEB_PORT=4311 tsx watch src/server/index.ts",
    "serve:client": "vite preview --host 0.0.0.0 --port 4310 --strictPort",
    "dev:client": "vite --host 0.0.0.0 --port 4310",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --minify --legal-comments=none --outfile=dist/server/index.js",
    "start": "NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:ui": "npm run build:client && playwright test --config playwright.ui.config.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.15"
  }
}
